# --- App ---
APP_NAME=QueryMind
APP_HOST=http://localhost:3000
SECRET_KEY=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=["http://localhost:3000"]

# --- Database ---
DATABASE_URL=postgresql://postgres:querymind123@localhost:5433/querymind

# --- Redis ---
REDIS_URL=redis://localhost:6380/0
REDIS_REFRESH_DB=1
CACHE_EXPIRE_SECONDS=300

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google-auth
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v2/userinfo

# --- SMTP (transactional email) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@querymind.app
SMTP_FROM_NAME=QueryMind
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false

# --- SendGrid (HTTPS email API; preferred over SMTP for hosted deploys) ---
SENDGRID_API_KEY=

# --- LLM (DeepSeek) ---
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-deepseek-api-key
LLM_MODEL=deepseek-v4-flash

# --- Upload limits ---
MAX_UPLOAD_BYTES=52428800
